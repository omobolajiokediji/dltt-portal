rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (auth.uid)
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - email: string (optional)
    //   - phone: string (optional)
    //   - role: string (required, enum: super-admin, admin, pro-trainer, master-trainer, trainer, teacher)
    //   - state: string (required)
    //   - school: string (optional)
    //   - profilePhoto: string (optional)
    //   - certificateName: string (optional)
    //   - approvedForCertificate: bool (optional)
    //   - totalScore: number (optional)
    //   - attendance: map (optional)
    //   - assignmentCompletion: map (optional)
    //   - trainerId: string (optional; set on teachers managed by trainers)
    //   - createdBy: string (optional)
    //
    // Collection: materials
    // Document ID: materialId
    // Fields:
    //   - id: string (required)
    //   - title: string (required)
    //   - description: string (optional)
    //   - type: string (required, enum: slide, pdf, assignment)
    //   - contentUrl: string (required)
    //   - assignedTo: list (required)
    //   - assignedStates: list (required)
    //   - dueDate: string (optional)
    //   - week: number (required)
    //   - createdAt: string (required)
    //
    // Collection: submissions
    // Document ID: submissionId
    // Fields:
    //   - id: string (required)
    //   - teacherId: string (required)
    //   - materialId: string (required)
    //   - contentUrl: string (required)
    //   - submittedAt: string (required)
    //   - score: number (optional)
    //   - feedback: string (optional)
    //   - status: string (required, enum: pending, graded)
    //
    // Collection: stats
    // Document ID: global
    // Fields:
    //   - enrollment: number
    //   - completionRate: number
    //   - stateLeaderboard: list
    //   - teacherLeaderboard: list
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == "omobolajiokediji@gmail.com" || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin']));
    }

    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.email == "omobolajiokediji@gmail.com" || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'));
    }

    function isTrainer() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['trainer', 'master-trainer', 'pro-trainer'];
    }

    function isManagedTeacher(teacherId) {
      return isTrainer() &&
             exists(/databases/$(database)/documents/users/$(teacherId)) &&
             get(/databases/$(database)/documents/users/$(teacherId)).data.role == 'teacher' &&
             get(/databases/$(database)/documents/users/$(teacherId)).data.trainerId == request.auth.uid;
    }

    function canReadManagedTeacher(data) {
      return isTrainer() &&
             data.role == 'teacher' &&
             data.trainerId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'state']) &&
             data.uid is string &&
             data.name is string && data.name.size() < 100 &&
             data.role in ['super-admin', 'admin', 'pro-trainer', 'master-trainer', 'trainer', 'teacher'] &&
             data.state is string;
    }

    function isTrainerCreatedTeacher(userId) {
      return isTrainer() &&
             request.resource.data.uid == userId &&
             request.resource.data.role == 'teacher' &&
             request.resource.data.trainerId == request.auth.uid &&
             request.resource.data.createdBy == request.auth.uid &&
             isValidUser(request.resource.data);
    }

    function trainerCanUpdateManagedTeacher(userId) {
      return isManagedTeacher(userId) &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.role == 'teacher' &&
             request.resource.data.trainerId == request.auth.uid &&
             isValidUser(request.resource.data) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'name',
               'email',
               'phone',
               'state',
               'school',
               'gender',
               'attendance',
               'assignmentCompletion',
               'totalScore',
               'lastLoginAt',
               'accountNumber',
               'bank',
               'accountName',
               'certificateName'
             ]);
    }

    function certificateApprovalChangeAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'approvedForCertificate',
               'certifications'
             ]) ||
             isAdmin();
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'contentUrl', 'week']) &&
             data.title is string && data.title.size() < 200 &&
             data.type in ['slide', 'pdf', 'assignment', 'video', 'audio'] &&
             data.contentUrl is string &&
             data.week is number;
    }

    function isValidTrainerMaterial(data) {
      return isTrainer() &&
             isValidMaterial(data) &&
             data.type == 'assignment' &&
             data.createdBy == request.auth.uid &&
             data.assignedTo is list &&
             !data.assignedTo.hasAny(['all']) &&
             data.assignedStates is list &&
             data.assignedStates.size() == 0;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'teacherId', 'materialId', 'contentUrl', 'submittedAt', 'status']) &&
             data.id is string &&
             data.teacherId == request.auth.uid &&
             data.materialId is string &&
             data.contentUrl is string &&
             data.submittedAt is string &&
             data.status == 'pending';
    }

    function isValidAdminSubmission(data) {
      return data.keys().hasAll(['id', 'teacherId', 'materialId', 'contentUrl', 'submittedAt', 'score', 'feedback', 'status']) &&
             data.id is string &&
             data.teacherId is string &&
             data.materialId is string &&
             data.contentUrl is string &&
             data.submittedAt is string &&
             data.score is number &&
             data.score >= 0 &&
             data.score <= 100 &&
             data.feedback is string &&
             data.status in ['pending', 'graded'];
    }

    function isValidAdminSubmissionUpdate(data) {
      return data.keys().hasAll(['teacherId', 'materialId', 'contentUrl', 'submittedAt', 'score', 'feedback', 'status']) &&
             data.teacherId is string &&
             data.materialId is string &&
             data.contentUrl is string &&
             data.submittedAt is string &&
             data.score is number &&
             data.score >= 0 &&
             data.score <= 100 &&
             data.feedback is string &&
             data.status in ['pending', 'graded'];
    }

    function adminCanUpdateSubmission() {
      return isAuthenticated() &&
             request.resource.data.teacherId == resource.data.teacherId &&
             request.resource.data.materialId == resource.data.materialId &&
             (!resource.data.keys().hasAny(['id']) || request.resource.data.id == resource.data.id) &&
             isValidAdminSubmissionUpdate(request.resource.data) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'feedback', 'status', 'contentUrl', 'submittedAt']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() &&
                    (isOwner(userId) || isAdmin() || canReadManagedTeacher(resource.data));
      allow create: if ((isAdmin() || isSuperAdmin()) && isValidUser(request.resource.data)) ||
                       isTrainerCreatedTeacher(userId);
      allow update: if ((isAdmin() || isSuperAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role)) &&
                        isValidUser(request.resource.data) &&
                        certificateApprovalChangeAllowed()) ||
                       trainerCanUpdateManagedTeacher(userId);
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSuperAdmin() || isValidTrainerMaterial(request.resource.data);
      allow update: if isAdmin() || isSuperAdmin() ||
                    (isTrainer() && resource.data.createdBy == request.auth.uid && isValidTrainerMaterial(request.resource.data));
      allow delete: if isAdmin() || isSuperAdmin() ||
                    (isTrainer() && resource.data.createdBy == request.auth.uid);
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.teacherId) || isAdmin() || isSuperAdmin() || isManagedTeacher(resource.data.teacherId));
      allow create: if ((isAdmin() || isSuperAdmin()) && isValidAdminSubmission(request.resource.data)) ||
                    (isAuthenticated() && isValidSubmission(request.resource.data));
      allow update: if ((isAdmin() || isSuperAdmin()) || (isTrainer() && isManagedTeacher(resource.data.teacherId))) && adminCanUpdateSubmission();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /stats/{docId} {
      allow read: if true; // Public dashboard
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}
